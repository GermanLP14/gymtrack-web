{
  "expo": {
    "name": "Plitt Fit",
    "slug": "gymtrack-web",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtrack",
    "userInterfaceStyle": "automatic",
    "platforms": ["web"],
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "baseUrl": "/gymtrack-web",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
